{
  "token_file": "/etc/dnctl/token",
  "state_dir": "/var/lib/dnctl",
  "interval": "15m",

  "listen": "127.0.0.1:8787",
  "path": "/dartnode/webhook",
  "secret_file": "/etc/dnctl/webhook-secret",
  "previous_secret_file": "/etc/dnctl/webhook-secret.previous",

  "expect": {
    "hosts": ["web-1.example.com", "db-1.example.com"],
    "alert_new_hosts": true,
    "ips": [],
    "min_credit": 10,
    "webhook_url": "https://hooks.example.com/dartnode/webhook"
  },

  "sinks": [
    { "type": "stdout", "min_severity": "info" },
    { "type": "slack", "url_file": "/etc/dnctl/slack-url", "min_severity": "warning" },
    { "type": "matrix", "homeserver": "https://matrix.example.com", "room_id": "!roomid:example.com", "token_file": "/etc/dnctl/matrix-token", "min_severity": "warning" }
  ]
}
